#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ORCHESTRA_HOME="${ORCHESTRA_HOME:-$HOME/.hermes-orchestra}"
AUDIT_ROOT="${AUDIT_ROOT:-$HOME/.local/share/hermes-orchestra}"

if [ -f "$ORCHESTRA_HOME/lib/orch-common.sh" ]; then
    # shellcheck source=/dev/null
    source "$ORCHESTRA_HOME/lib/orch-common.sh"
else
    # shellcheck source=/dev/null
    source "$SCRIPT_DIR/../lib/orch-common.sh"
fi

PROJECT_ID=""
LEVEL_FILTER=""
LIMIT="20"
RUN_ID=""
OUTPUT=""
STATE_ROOT="${STATE_ROOT:-$HOME/.local/share/hermes-orchestra-state}"

find_repo_root() {
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/config/performance/slo-policy.json" ] && [ -d "$dir/scripts/lib" ]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --run-id)
            RUN_ID="${2:-}"
            shift 2
            ;;
        --output)
            OUTPUT="${2:-}"
            shift 2
            ;;
        --state-root)
            STATE_ROOT="${2:-}"
            shift 2
            ;;
        --level)
            LEVEL_FILTER="${2:-}"
            shift 2
            ;;
        --limit)
            LIMIT="${2:-20}"
            shift 2
            ;;
        -*)
            echo "Usage: orch-audit [project-id] [--level L1|L2|L3|L4] [--limit N] [--run-id RUN --state-root DIR --output FILE]" >&2
            exit 1
            ;;
        *)
            PROJECT_ID="$1"
            shift
            ;;
    esac
done

if [ -n "$RUN_ID" ] || [ -n "$OUTPUT" ]; then
    if [ -z "$RUN_ID" ] || [ -z "$OUTPUT" ]; then
        echo "orch-audit metrics mode requires --run-id and --output" >&2
        exit 1
    fi
    REPO_ROOT="$(find_repo_root)" || {
        echo "Could not find repo root containing config/performance/slo-policy.json" >&2
        exit 1
    }
    PYTHONPATH="$REPO_ROOT/scripts/lib${PYTHONPATH:+:$PYTHONPATH}" python3 - "$REPO_ROOT" "$STATE_ROOT" "$RUN_ID" "$OUTPUT" <<'PY'
import sys
from pathlib import Path

from success_metrics import aggregate_run, atomic_write_json

repo_root, state_root, run_id, output = sys.argv[1:]
summary = aggregate_run(Path(repo_root), Path(state_root), run_id)
atomic_write_json(output, summary)
print(output)
PY
    exit 0
fi

[ -z "$PROJECT_ID" ] || orch_validate_project_id "$PROJECT_ID"

python3 - "$AUDIT_ROOT" "$PROJECT_ID" "$LEVEL_FILTER" "$LIMIT" <<'PY'
import glob
import json
import os
import sys

audit_root, project_id, level_filter, limit_text = sys.argv[1:]
try:
    limit = int(limit_text)
except ValueError:
    limit = 20

root = os.path.realpath(audit_root)
if project_id:
    path = os.path.realpath(os.path.join(root, project_id, "audit.jsonl"))
    if not path.startswith(root + os.sep):
        sys.exit("project path escapes audit root")
    files = [path]
else:
    files = glob.glob(os.path.join(root, "*", "audit.jsonl"))

records = []
for path in files:
    if not os.path.exists(path):
        continue
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            if level_filter and record.get("level") != level_filter:
                continue
            records.append(record)

records.sort(key=lambda item: item.get("timestamp", ""), reverse=True)
print("timestamp\tproject\tlevel\ttype\tdecision\tdetails")
for record in records[:limit]:
    print("\t".join(str(record.get(field, "")) for field in ("timestamp", "project", "level", "type", "decision", "details")))
PY
