#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ORCHESTRA_HOME="${ORCHESTRA_HOME:-$HOME/.hermes-orchestra}"
METRICS=""
THRESHOLDS=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --metrics)
            METRICS="${2:-}"
            shift 2
            ;;
        --thresholds)
            THRESHOLDS="${2:-}"
            shift 2
            ;;
        *)
            echo "Usage: orch-verify [--metrics metrics_summary.json --thresholds config/performance/slo-policy.json]" >&2
            exit 1
            ;;
    esac
done

find_repo_root() {
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/config/performance/slo-policy.json" ] && [ -d "$dir/scripts/lib" ]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

if [ -n "$METRICS" ] || [ -n "$THRESHOLDS" ]; then
    if [ -z "$METRICS" ] || [ -z "$THRESHOLDS" ]; then
        echo "orch-verify metrics mode requires --metrics and --thresholds" >&2
        exit 1
    fi
    REPO_ROOT="$(find_repo_root)" || {
        echo "Could not find repo root containing config/performance/slo-policy.json" >&2
        exit 1
    }
    PYTHONPATH="$REPO_ROOT/scripts/lib${PYTHONPATH:+:$PYTHONPATH}" python3 - "$METRICS" "$THRESHOLDS" <<'PY'
import json
import sys
from pathlib import Path

from success_metrics import verify_metrics

metrics_path, thresholds_path = map(Path, sys.argv[1:])
with metrics_path.open(encoding="utf-8") as handle:
    metrics = json.load(handle)
with thresholds_path.open(encoding="utf-8") as handle:
    policy = json.load(handle)
report = verify_metrics(metrics, policy)
print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
raise SystemExit(0 if report["release_approved"] else 1)
PY
    exit "$?"
fi

echo "Hermes Dev Orchestra smoke verification"

# 策略：从当前工作目录向上查找源码仓库。
# 这样无论 orch-verify 是通过 ~/.local/bin/ 符号链接调用，还是直接调用，
# 只要在仓库目录（或其子目录）中运行，就能找到正确的测试套件。
find_repo_tests() {
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/scripts/setup.sh" ] && [ -x "$dir/scripts/tests/run-all.sh" ]; then
            echo "$dir/scripts/tests/run-all.sh"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

REPO_TESTS="$(find_repo_tests 2>/dev/null || true)"
if [ -n "$REPO_TESTS" ]; then
    exec "$REPO_TESTS"
fi

# 不在仓库目录中 — 已安装的测试有路径解析 bug，直接提示用户
echo "" >&2
echo "无法找到源码仓库中的测试套件。" >&2
echo "" >&2
echo "请在仓库根目录（或子目录）中重新运行：" >&2
echo "  cd /data/hermes && orch-verify" >&2
echo "" >&2
echo "原因：已安装到 ~/.hermes-orchestra/tests/ 的测试脚本依赖源码目录结构，" >&2
echo "      在非仓库目录中运行时路径解析会失败。" >&2
exit 1
